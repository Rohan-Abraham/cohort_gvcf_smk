include: "snakefiles/variant.snake"


rule all_targets:
    input:
        expand(
            os.path.join(GVCF_DIR_PATTERN, "{sample}.g.vcf.gz"),
            sample=SAMPLE_IDS,
        ),
        expand(
            os.path.join(GVCF_DIR_PATTERN, "{sample}.g.vcf.gz.tbi"),
            sample=SAMPLE_IDS,
        ),
