import os
from csv import reader

configfile: "configs/config.yaml"

# Default tmp_dir in the current directory.
if type(config["tmp_dir"]) == type(None):
    config["tmp_dir"] = ""


def samples_table_cram(wildcards, keys_list=False):
    samples = {}
    with open(config["samples"], "r") as handle:
        iterator = reader(handle, delimiter=",")
        next(iterator, None)
        for row in iterator:
            sample = os.path.basename(row[0]).split(".")[0]
            samples[sample] = row[0]
    if keys_list:
        return sorted(samples.keys())
    return {
        "cram": samples[wildcards.sample],
        "crai": samples[wildcards.sample] + ".crai",
    }
