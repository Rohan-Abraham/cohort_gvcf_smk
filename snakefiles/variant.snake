include: "common.snake"
include: "align.snake"


rule gatk_haplotypecaller:
    input:
        unpack(calling_alignment),
        qc=alignment_qc_dependencies,
        ref=REFERENCE_FASTA,
        ref_fai=REFERENCE_FAI,
        ref_dict=REFERENCE_DICT,
        interval=os.path.join(
            config["GATK"]["haplotypecaller"]["interval_dir"],
            "{interval}.interval_list",
        ),
    output:
        gvcf=temp(
            os.path.join(
                TMP_DIR,
                "gvcf",
                "{sample}",
                "{sample}-{interval}.g.vcf.gz",
            )
        ),
        tbi=temp(
            os.path.join(
                TMP_DIR,
                "gvcf",
                "{sample}",
                "{sample}-{interval}.g.vcf.gz.tbi",
            )
        ),
    log:
        os.path.join("log", "{sample}", "haplotypecaller", "{interval}.log"),
    benchmark:
        os.path.join(
            "log", "{sample}", "haplotypecaller", "{interval}.benchmark.txt"
        ),
    params:
        dragen=config["GATK"]["haplotypecaller"]["dragen_mode"],
    container:
        config["containers"]["broad_gatk"],
    threads:
        config["GATK"]["haplotypecaller"]["threads"],
    resources:
        mem_mb=config["GATK"]["haplotypecaller"]["mem_mb"],
        time_limit=config["GATK"]["haplotypecaller"]["time_limit"],
    shell:
        r"""
        mkdir -p $(dirname {output.gvcf:q}) $(dirname {log:q})
        /gatk/gatk \
          --java-options "-Xmx24g -XX:+UseParallelGC -XX:ParallelGCThreads={threads}" \
          HaplotypeCaller \
          --input {input.alignment:q} --reference {input.ref:q} \
          --output {output.gvcf:q} --intervals {input.interval:q} \
          --emit-ref-confidence GVCF --max-alternate-alleles 6 \
          --read-filter OverclippedReadFilter --output-mode EMIT_VARIANTS_ONLY \
          --pair-hmm-implementation AVX_LOGLESS_CACHING_OMP \
          --native-pair-hmm-threads {threads} --dragen-mode {params.dragen} \
          --annotation-group AS_StandardAnnotation \
          2> {log:q}
        """


rule gatk_haplotypecaller_merge:
    input:
        gvcfs=expand(
            os.path.join(
                TMP_DIR,
                "gvcf",
                "{{sample}}",
                "{{sample}}-{interval}.g.vcf.gz",
            ),
            interval=INTERVAL_IDS,
        ),
        indexes=expand(
            os.path.join(
                TMP_DIR,
                "gvcf",
                "{{sample}}",
                "{{sample}}-{interval}.g.vcf.gz.tbi",
            ),
            interval=INTERVAL_IDS,
        ),
    output:
        gvcf=protected(os.path.join(GVCF_DIR_PATTERN, "{sample}.g.vcf.gz")),
        tbi=protected(os.path.join(GVCF_DIR_PATTERN, "{sample}.g.vcf.gz.tbi")),
    log:
        os.path.join("log", "{sample}", "gvcf_merge.log"),
    benchmark:
        os.path.join("log", "{sample}", "gvcf_merge.benchmark.txt"),
    container:
        config["containers"]["hostseq_utilities"],
    threads:
        config["GATK"]["merge"]["threads"],
    resources:
        mem_mb=config["GATK"]["merge"]["mem_mb"],
        time_limit=config["GATK"]["merge"]["time_limit"],
    shell:
        r"""
        mkdir -p $(dirname {output.gvcf:q}) $(dirname {log:q})
        /opt/bcftools-1.14/bcftools concat {input.gvcfs:q} \
          --output {output.gvcf:q} --output-type z --threads {threads} \
          --allow-overlaps 2> {log:q}
        /opt/bcftools-1.14/bcftools index {output.gvcf:q} \
          --tbi --threads {threads} 2>> {log:q}
        """
